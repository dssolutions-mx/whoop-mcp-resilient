{
  "name": "whoop-mcp-resilient",
  "version": "1.0.0",
  "mcpName": "io.github.dssolutions-mx/whoop-mcp-resilient",
  "description": "Resilient MCP server for WHOOP health data: retries WHOOP outages, race-safe token refresh, natural-language dates and compact output. Fork of whoop-ai-mcp.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whoop-mcp-resilient": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "keywords": [
    "whoop",
    "mcp",
    "model-context-protocol",
    "health",
    "fitness",
    "recovery",
    "sleep",
    "ai",
    "claude"
  ],
  "author": "Juan Jose Aguirre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dssolutions-mx/whoop-mcp-resilient.git"
  },
  "homepage": "https://github.com/dssolutions-mx/whoop-mcp-resilient#readme",
  "bugs": {
    "url": "https://github.com/dssolutions-mx/whoop-mcp-resilient/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  },
  "contributors": [
    "Shashank Mishra (original whoop-ai-mcp, https://github.com/shashankswe2020-ux/whoop-mcp)"
  ]
}
